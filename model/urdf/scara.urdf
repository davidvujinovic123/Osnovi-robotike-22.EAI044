    <link name="link3">

        <visual>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
            <geometry>
                <box size="0.04 0.04 0.38"/>
            </geometry>
            <material name="red">
                <color rgba="0.8 0.1 0.1 1"/>
